import java.sql.*;

public class ViewFinancialData {

    public static void view() {

        try {
            Connection con = DBConnection.connect();

            String sql = "SELECT * FROM financial_data";
            Statement st = con.createStatement();
            ResultSet rs = st.executeQuery(sql);

            System.out.println("\n========== FINANCIAL DATA ==========");
            System.out.println("Year\tNet Profit\tTotal Assets\tEquity\tCurrent Assets\tCurrent Liabilities");

            while (rs.next()) {
                System.out.println(
                    rs.getInt("year") + "\t" +
                    rs.getDouble("net_profit") + "\t" +
                    rs.getDouble("total_assets") + "\t" +
                    rs.getDouble("shareholders_equity") + "\t" +
                    rs.getDouble("current_assets") + "\t" +
                    rs.getDouble("current_liabilities")
                );
            }

            rs.close();
            st.close();
            con.close();

        } catch (Exception e) {
            e.printStackTrace();
        }
    }
}