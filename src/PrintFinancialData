import java.sql.*;

public class PrintFinancialData {

    public static void printReport() {

        try {
            Connection con = DBConnection.connect();

            Statement st = con.createStatement();
            ResultSet rs = st.executeQuery("SELECT * FROM financial_data");

            System.out.println("\n========== SBI FINANCIAL REPORT ==========");
            System.out.println("Year\tNet Profit\tAssets");

            while(rs.next()) {
                System.out.println(
                    rs.getInt("year") + "\t" +
                    rs.getDouble("net_profit") + "\t" +
                    rs.getDouble("total_assets")
                );
            }

            rs.close();
            st.close();
            con.close();

        } catch(Exception e) {
            e.printStackTrace();
        }
    }
}